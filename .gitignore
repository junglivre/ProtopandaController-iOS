# Xcode project is generated by XcodeGen (see App/project.yml); do not commit it.
App/*.xcodeproj/
App/build/
App/DerivedData/
App/Payload/
App/*.ipa

# Xcode user data, in case a project file is ever committed by accident.
xcuserdata/
*.xccheckout
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
